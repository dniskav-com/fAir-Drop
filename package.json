{
  "name": "fairdrop",
  "packageManager": "bun@1",
  "version": "1.0.0",
  "description": "fAir Drop: P2P file sharing in the browser via WebRTC",
  "main": "server.js",
  "scripts": {
    "dev": "PORT=3003 node server.js & SERVER_PORT=3003 VITE_PORT=3002 vite",
    "build": "rm -rf public/app && vite build",
    "start": "NODE_ENV=production node server.js",
    "deploy": "npm run build && NODE_ENV=production node server.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts,.tsx src || true",
    "lint:fix": "eslint --ext .ts,.tsx src --fix"
  },
  "dependencies": {
    "eslint-config-prettier": "^10.1.8",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.22.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@humanfs/node": "0.17.0",
    "baseline-browser-mapping": "2.11.27",
    "browserslist": "4.29.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
